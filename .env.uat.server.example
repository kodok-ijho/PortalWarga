# Server-only local proxy values. Copy to .env.uat.server.local at repository root.
# Never prefix these values with VITE_.
APP_ENV=uat
UAT_SUPABASE_HOST=staging-project-ref.supabase.co
N8N_API_BASE_URL=https://n8n.example.invalid
N8N_WEBHOOK_NAMESPACE=portal-uat-v1
N8N_UAT_KEY=replace-with-one-window-random-key
N8N_BASIC_AUTH_USER=replace-with-uat-transport-user
N8N_BASIC_AUTH_PASSWORD=replace-with-uat-transport-password
